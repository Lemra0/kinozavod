# РЎРєРѕРїРёСЂСѓР№С‚Рµ СЌС‚РѕС‚ С„Р°Р№Р» РІ .env Рё РїСЂРё РЅРµРѕР±С…РѕРґРёРјРѕСЃС‚Рё РїРѕРјРµРЅСЏР№С‚Рµ Р·РЅР°С‡РµРЅРёСЏ.
# Copy this file to .env and adjust the values if needed.

# РџРѕСЂС‚ API-СЃРµСЂРІРµСЂР° / API server port
PORT=3001

# РђРґСЂРµСЃ РєР»РёРµРЅС‚Р° РІ СЂРµР¶РёРјРµ СЂР°Р·СЂР°Р±РѕС‚РєРё / Client URL in development
CLIENT_URL=http://localhost:5173

# РџСѓС‚СЊ Рє С„Р°Р№Р»Сѓ Р±Р°Р·С‹ SQLite (РѕС‚РЅРѕСЃРёС‚РµР»СЊРЅРѕ РїР°РїРєРё server) / SQLite file path (relative to /server)
DATABASE_PATH=data/kinozavod.db

# Р”РµРјРѕ-СЂРµР¶РёРј: Р±С‹СЃС‚СЂС‹Р№ РІС…РѕРґ Р·Р° СЂРѕР»Рё Рё РґРµРјРѕ-РґР°РЅРЅС‹Рµ / Demo mode: quick role login and demo data
DEMO_MODE=false

# РљР»СЋС‡ TMDB (РЅРµРѕР±СЏР·Р°С‚РµР»РµРЅ; Р±РµР· РЅРµРіРѕ РёСЃРїРѕР»СЊР·СѓСЋС‚СЃСЏ РґРµРјРѕ-С„РёР»СЊРјС‹) / TMDB key (optional; demo movies are used without it)
TMDB_API_KEY=

# РЎРµРєСЂРµС‚ РґР»СЏ СЃРµСЃСЃРёР№ вЂ” Р·Р°РјРµРЅРёС‚Рµ РЅР° РґР»РёРЅРЅСѓСЋ СЃР»СѓС‡Р°Р№РЅСѓСЋ СЃС‚СЂРѕРєСѓ / Session secret вЂ” replace with a long random string
SESSION_SECRET=change-me-to-a-long-random-string
